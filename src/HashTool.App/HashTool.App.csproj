<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>HashTool.App</RootNamespace>
        <!-- Every 1.x release shipped CheckHash(.exe) as Velopack's mainExe; keep the name so updates keep working. -->
        <AssemblyName>CheckHash</AssemblyName>
        <AssemblyTitle>Hash Tool</AssemblyTitle>
        <Description>Generate, verify and manage file hashes.</Description>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\icon\favicon.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\icon\favicon.ico" />
        <AvaloniaResource Include="Assets\logo_in_app.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Material.Icons.Avalonia" />
        <PackageReference Include="Velopack" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HashTool.Core\HashTool.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="HashTool.Core" />
        <Using Include="HashTool.Core.Configuration" />
        <Using Include="HashTool.Core.Hashing" />
        <Using Include="HashTool.Core.IO" />
        <Using Include="HashTool.Core.Processing" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Lang\Languages.json" />
    </ItemGroup>


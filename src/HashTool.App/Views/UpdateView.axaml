<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HashTool.App.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="HashTool.App.Views.UpdateView"
             x:DataType="vm:UpdateViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Spacing="16" Margin="0,0,0,20">
            <TextBlock Text="{Binding Localization[Title_Update]}" FontSize="24" FontWeight="Bold" />

            <Border Classes="card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <icons:MaterialIcon Kind="InformationOutline" Width="24" Height="24" Margin="0,0,10,0"
                                            Foreground="{DynamicResource StatusInfoBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentVersionText}" FontSize="16" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Command="{Binding CheckCommand}" Classes="accent">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <icons:MaterialIcon Kind="CloudSync" Width="18" Height="18" IsVisible="{Binding !IsChecking}" />
                                <ProgressBar IsIndeterminate="True" Width="18" MinWidth="18" Height="4" VerticalAlignment="Center"
                                             IsVisible="{Binding IsChecking}" />
                                <TextBlock Text="{Binding Localization[Btn_CheckNow]}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <SelectableTextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold" />

                    <StackPanel Spacing="8" IsVisible="{Binding IsDownloading}">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Height="8" />
                        <Button Content="{Binding Localization[Btn_Cancel]}" Command="{Binding CancelDownloadCommand}" HorizontalAlignment="Right" />
                    </StackPanel>

                    <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding CanInstall}">
                        <Button Classes="accent" Command="{Binding InstallCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <icons:MaterialIcon Kind="Restart" Width="18" Height="18" />
                                <TextBlock Text="{Binding Localization[Btn_Install]}" />
                            </StackPanel>
                        </Button>
                        <Button Content="{Binding Localization[Btn_InstallOnExit]}" Command="{Binding InstallOnExitCommand}" />
                        <Button Content="{Binding Localization[Btn_OpenReleasePage]}" Command="{Binding OpenReleasePageCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding ReleaseNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Spacing="10">
                    <TextBlock Classes="sectionTitle" Text="{Binding Localization[Lbl_ReleaseNotes]}" />
                    <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                        <SelectableTextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization[Settings_AutoUpdate]}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Localization[Settings_AutoUpdateDesc]}" Classes="secondary" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckOnStartup}"
                                  AutomationProperties.Name="{Binding Localization[Settings_AutoUpdate]}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HashTool.App.ViewModels"
             xmlns:controls="using:HashTool.App.Views.Controls"
             xmlns:conv="using:HashTool.App.Converters"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="HashTool.App.Views.CreateHashView"
             x:DataType="vm:CreateHashViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding Localization[Title_CreateHash]}" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding Localization[Help_CreateHash]}" Classes="secondary" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                <TextBlock Text="{Binding TotalFilesText}" Classes="secondary" HorizontalAlignment="Right" IsVisible="{Binding !IsBusy}" />
                <TextBlock Text="{Binding ProgressText}" FontWeight="Bold" HorizontalAlignment="Right" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding DetailText}" FontSize="11" HorizontalAlignment="Right" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding SpeedText}" FontSize="11" Classes="status" HorizontalAlignment="Right" IsVisible="{Binding IsBusy}" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10" ItemSpacing="8" LineSpacing="8">
            <Button Content="{Binding Localization[Btn_AddFiles]}" Command="{Binding AddFilesCommand}" ToolTip.Tip="Ctrl+O" />
            <Button Content="{Binding Localization[Btn_AddFolder]}" Command="{Binding AddFolderCommand}" ToolTip.Tip="Ctrl+Shift+O" />
            <Button Content="{Binding Localization[Btn_Clear]}" Command="{Binding ClearListCommand}" IsVisible="{Binding HasItems}" />
            <Button Content="{Binding Localization[Btn_ClearHashes]}" Command="{Binding ClearResultsCommand}" IsVisible="{Binding HasItems}" />
            <Button Content="{Binding Localization[Btn_ClearFailed]}" Command="{Binding ClearFailedCommand}" IsVisible="{Binding HasItems}" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding CanModify}">
                <TextBlock Text="{Binding Localization[Lbl_Algorithm]}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Algorithms}" SelectedItem="{Binding SelectedAlgorithm}" MinWidth="130"
                          AutomationProperties.Name="{Binding Localization[Lbl_Algorithm]}" />
            </StackPanel>
            <Button IsVisible="{Binding HasItems}" IsEnabled="{Binding CanModify}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="Export" Width="16" Height="16" />
                    <TextBlock Text="{Binding Localization[Btn_Export]}" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="{Binding Localization[Export_ChecksumFile]}" Command="{Binding ExportChecksumFileCommand}" />
                        <MenuItem Header="{Binding Localization[Btn_Compress]}" Command="{Binding CompressCommand}" />
                        <MenuItem Header="{Binding Localization[Export_CopyAll]}" Command="{Binding CopyAllCommand}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Content="{Binding Localization[Btn_CalcAll]}" Classes="accent" Command="{Binding RunAllCommand}"
                    IsVisible="{Binding !IsBusy}" ToolTip.Tip="Ctrl+Enter" />
            <Button Content="{Binding Localization[Btn_Cancel]}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" ToolTip.Tip="Esc" />
            <TextBlock Text="{Binding RemainingText}" VerticalAlignment="Center" FontWeight="SemiBold" IsVisible="{Binding IsBusy}" />
        </WrapPanel>

        <!-- Filters -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8" IsVisible="{Binding HasItems}">
            <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="{Binding Localization[Watermark_Search]}"
                     MaxWidth="420" HorizontalAlignment="Left" MinWidth="200"
                     AutomationProperties.Name="{Binding Localization[Watermark_Search]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"
                      MinWidth="150" Margin="8,0,0,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource EnumLabelConverter}">
                                    <Binding />
                                    <Binding Path="$parent[UserControl].((vm:CreateHashViewModel)DataContext).Localization" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="2" ItemsSource="{Binding SizeFilterOptions}" SelectedItem="{Binding SelectedSizeFilter}"
                      MinWidth="170" Margin="8,0,0,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource EnumLabelConverter}">
                                    <Binding />
                                    <Binding Path="$parent[UserControl].((vm:CreateHashViewModel)DataContext).Localization" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <ProgressBar Grid.Row="3" Minimum="0" Maximum="1" Value="{Binding ProgressValue}" IsVisible="{Binding IsBusy}"
                     Height="4" Margin="0,0,0,8" />

        <!-- The whole area accepts dropped files and folders. -->
        <Panel Grid.Row="4" x:Name="DropArea" DragDrop.AllowDrop="True" Background="Transparent">
            <Border x:Name="DropHighlight" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource SystemAccentColor}"
                    IsVisible="False" IsHitTestVisible="False" ZIndex="1" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Opacity="0.6" IsVisible="{Binding !HasItems}">
                <icons:MaterialIcon Kind="FilePlusOutline" Width="64" Height="64" />
                <TextBlock Text="{Binding Localization[EmptyState_DropFiles]}" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent" IsVisible="{Binding HasItems}">
                <ListBox.KeyBindings>
                    <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedCommand}" />
                </ListBox.KeyBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileItem">
                        <Grid ColumnDefinitions="3*,Auto,Auto,4*,2*,Auto" Margin="0,2">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="{Binding FilePath}" MinWidth="140">
                                <controls:HighlightTextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                             HighlightText="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).SearchText}"
                                                             HighlightBrush="{DynamicResource SystemAccentColor}" />
                                <TextBlock Text="{Binding DirectoryName}" FontSize="10" Classes="secondary" TextTrimming="LeadingCharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="76">
                                <TextBlock Text="{Binding SizeText}" FontSize="11" Classes="secondary" />
                                <TextBlock Text="{Binding Duration}" FontSize="11" Classes="status success"
                                           IsVisible="{Binding Duration, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <ComboBox Grid.Column="2" ItemsSource="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Algorithms}"
                                      SelectedItem="{Binding Algorithm}" VerticalAlignment="Center" Width="120" Margin="0,0,8,0"
                                      AutomationProperties.Name="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Lbl_Algorithm]}">
                                <ComboBox.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="!IsProcessing" />
                                        <Binding Path="$parent[ListBox].((vm:CreateHashViewModel)DataContext).CanModify" />
                                    </MultiBinding>
                                </ComboBox.IsEnabled>
                            </ComboBox>

                            <Grid Grid.Column="3" ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center" MinWidth="160">
                                <Panel>
                                    <TextBox IsReadOnly="True" FontFamily="Consolas, Menlo, monospace" FontSize="11" BorderThickness="0"
                                             Background="Transparent" TextWrapping="NoWrap" IsVisible="{Binding !ShowProgress}">
                                        <TextBox.Text>
                                            <MultiBinding Converter="{StaticResource HashMaskConverter}">
                                                <Binding Path="ResultHash" />
                                                <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).IsHashMaskingEnabled" />
                                                <Binding Path="IsRevealed" />
                                            </MultiBinding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding ShowProgress}"
                                                 VerticalAlignment="Center" Height="6" />
                                </Panel>
                                <ToggleButton Grid.Column="1" Classes="icon" IsChecked="{Binding IsRevealed}" Background="Transparent" Padding="4"
                                              IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsHashMaskingEnabled}"
                                              ToolTip.Tip="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Tip_HashVisibility]}"
                                              AutomationProperties.Name="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Tip_HashVisibility]}">
                                    <Panel>
                                        <icons:MaterialIcon Kind="EyeOutline" Width="16" Height="16" IsVisible="{Binding !IsRevealed}" />
                                        <icons:MaterialIcon Kind="EyeOffOutline" Width="16" Height="16" IsVisible="{Binding IsRevealed}" />
                                    </Panel>
                                </ToggleButton>
                                <Button Grid.Column="2" Classes="icon"
                                        Command="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).CopyTextCommand}"
                                        CommandParameter="{Binding ResultHash}"
                                        IsVisible="{Binding ResultHash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        ToolTip.Tip="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Tip_CopyHash]}"
                                        AutomationProperties.Name="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Tip_CopyHash]}">
                                    <icons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
                                </Button>
                            </Grid>

                            <TextBlock Grid.Column="4" Classes="status" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="8,0"
                                       Classes.success="{Binding Status, Converter={x:Static conv:StatusSeverity.IsSuccess}}"
                                       Classes.error="{Binding Status, Converter={x:Static conv:StatusSeverity.IsError}}"
                                       Classes.warning="{Binding Status, Converter={x:Static conv:StatusSeverity.IsWarning}}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource StatusTextConverter}">
                                        <Binding Path="Status" />
                                        <Binding Path="StatusDetail" />
                                        <Binding Path="$parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Classes="icon" Command="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).SaveHashFileCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding ResultHash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        ToolTip.Tip="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Dialog_SaveHash]}"
                                        AutomationProperties.Name="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Dialog_SaveHash]}">
                                    <icons:MaterialIcon Kind="ContentSave" Width="18" Height="18" />
                                </Button>
                                <Button Classes="icon" Command="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).RunItemCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Tip_Compute]}"
                                        AutomationProperties.Name="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Tip_Compute]}">
                                    <Panel>
                                        <icons:MaterialIcon Kind="PlayCircleOutline" Width="18" Height="18" Foreground="{DynamicResource StatusSuccessBrush}" IsVisible="{Binding !IsProcessing}" />
                                        <icons:MaterialIcon Kind="StopCircleOutline" Width="18" Height="18" Foreground="{DynamicResource StatusWarningBrush}" IsVisible="{Binding IsProcessing}" />
                                    </Panel>
                                </Button>
                                <Button Classes="icon" Command="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).ClearItemResultCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Tip_ClearHash]}"
                                        AutomationProperties.Name="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Tip_ClearHash]}">
                                    <icons:MaterialIcon Kind="Eraser" Width="18" Height="18" />
                                </Button>
                                <Button Classes="icon" Command="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).RemoveItemCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Tip_RemoveFile]}"
                                        AutomationProperties.Name="{Binding $parent[ListBox].((vm:CreateHashViewModel)DataContext).Localization[Tip_RemoveFile]}">
                                    <icons:MaterialIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="{DynamicResource StatusErrorBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Panel>
    </Grid>
</UserControl>

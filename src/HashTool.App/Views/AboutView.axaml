<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HashTool.App.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="HashTool.App.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <UserControl.Styles>
        <Style Selector="StackPanel.header">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="10" />
        </Style>
        <Style Selector="StackPanel.header > icons|MaterialIcon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Spacing="16" Margin="0,0,0,20">
            <TextBlock Text="{Binding Localization[Title_About]}" FontSize="24" FontWeight="Bold" />

            <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*">
                    <Image Source="/Assets/logo_in_app.png" Width="80" Height="80" VerticalAlignment="Top" Margin="0,0,24,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding AppName}" FontSize="24" FontWeight="Bold" />
                        <SelectableTextBlock Text="{Binding VersionText}" Classes="secondary" />
                        <TextBlock Text="{Binding Localization[About_Desc]}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Localization[About_License]}" Classes="secondary" FontStyle="Italic" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Classes="header">
                        <icons:MaterialIcon Kind="FileDocumentOutline" />
                        <TextBlock Classes="sectionTitle" Text="{Binding Localization[About_Documents]}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Documents}" Margin="34,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DocumentItem">
                                <Button Classes="icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Command="{Binding $parent[UserControl].((vm:AboutViewModel)DataContext).OpenUrlCommand}"
                                        CommandParameter="{Binding Url}" ToolTip.Tip="{Binding Url}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource EnumLabelConverter}">
                                                    <Binding />
                                                    <Binding Path="$parent[UserControl].((vm:AboutViewModel)DataContext).Localization" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <icons:MaterialIcon Grid.Column="1" Kind="OpenInNew" Width="16" Height="16" Opacity="0.6" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Classes="header">
                        <icons:MaterialIcon Kind="CodeTags" />
                        <TextBlock Classes="sectionTitle" Text="{Binding Localization[About_Tech]}" />
                    </StackPanel>
                    <StackPanel Spacing="10" Margin="34,0,0,0">
                        <TextBlock Text="{Binding TechnologyText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                            <icons:MaterialIcon Kind="Robot" Width="20" Height="20" Opacity="0.7" />
                            <TextBlock Text="{Binding Localization[About_AI]}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding Localization[About_AIContent]}" TextWrapping="Wrap" Classes="secondary" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Classes="header">
                        <icons:MaterialIcon Kind="AccountCircle" />
                        <TextBlock Classes="sectionTitle" Text="{Binding Localization[About_Author]}" />
                    </StackPanel>
                    <Button Classes="icon" Margin="34,0,0,0" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding GitHubProfile}"
                            ToolTip.Tip="{Binding Localization[Tip_GitHubProfile]}"
                            AutomationProperties.Name="{Binding Localization[Tip_GitHubProfile]}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:MaterialIcon Kind="Github" Width="24" Height="24" />
                            <TextBlock Text="{Binding AuthorName}" VerticalAlignment="Center" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Classes="header">
                        <icons:MaterialIcon Kind="PackageVariant" />
                        <TextBlock Classes="sectionTitle" Text="{Binding Localization[About_ThirdParty]}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Libraries}" Margin="34,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryItem">
                                <Button Classes="icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Command="{Binding $parent[UserControl].((vm:AboutViewModel)DataContext).OpenUrlCommand}"
                                        CommandParameter="{Binding Url}" ToolTip.Tip="{Binding Url}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Name}" />
                                                <Run Text="{Binding Version}" FontWeight="Normal" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding License}" FontSize="11" Classes="secondary" />
                                        </StackPanel>
                                        <icons:MaterialIcon Grid.Column="1" Kind="OpenInNew" Width="16" Height="16" Opacity="0.6" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Copyright}" HorizontalAlignment="Center" Classes="secondary" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
